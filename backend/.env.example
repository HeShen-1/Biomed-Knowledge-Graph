# ── Neo4j ──
BIOMED_NEO4J_URI=bolt://localhost:7687
BIOMED_NEO4J_USER=neo4j
BIOMED_NEO4J_PASSWORD=your_neo4j_password

# ── PostgreSQL ──
BIOMED_POSTGRES_DSN=postgresql://biomed:your_postgres_password@localhost:5434/biomed

# ── Redis (Celery broker) ──
BIOMED_REDIS_URL=redis://:your_redis_password@localhost:6380/0

# ── NCBI API Key (optional, avoid rate-limiting) ──
BIOMED_NCBI_API_KEY=

# ── Ingest ──
BIOMED_INGEST_RATE_LIMIT=3.0
BIOMED_INGEST_MAX_RETRIES=3

# ── Graph Query Defaults ──
BIOMED_GRAPH_DEFAULT_DEPTH=3
BIOMED_GRAPH_MAX_DEPTH=5
BIOMED_GRAPH_DEFAULT_LIMIT=200
BIOMED_GRAPH_MAX_LIMIT=1000

# ── Rate Limiting ──
BIOMED_RATE_LIMIT_GRAPH_EXPAND=30/minute
BIOMED_RATE_LIMIT_GRAPH_PATH=10/minute
BIOMED_RATE_LIMIT_GRAPH_NETWORK=20/minute
BIOMED_RATE_LIMIT_SEARCH=60/minute
